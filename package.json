{
  "name": "sgen",
  "version": "0.6.1",
  "description": "面向 Agent 的免费生图/生视频命令行工具与 DeepSeek Harness 插件（商汤 SenseNova + Agnes）",
  "type": "module",
  "bin": {
    "sgen": "bin/sgen.js"
  },
  "main": "./dsh-plugin/lib/index.js",
  "exports": {
    ".": "./dsh-plugin/lib/index.js",
    "./client": "./dsh-plugin/lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./dsh-plugin/locale/*.json",
    "./icon": "./dsh-plugin/icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "bin",
    "src",
    "skill",
    "cordis.patch.yml",
    "dsh-plugin/lib",
    "dsh-plugin/locale",
    "dsh-plugin/icon.svg",
    "dsh-plugin/cordis.patch.yml",
    "dsh-plugin/README.md",
    "dsh-plugin/package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qjy0128/sgen.git"
  },
  "keywords": [
    "image-generation",
    "video-generation",
    "cli",
    "agent",
    "dsh",
    "dsh-plugin",
    "sensenova",
    "agnes"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "test:dsh-plugin": "node --test 'dsh-plugin/test/*.test.mjs'",
    "check:syntax": "node scripts/check-syntax.js",
    "check:docs": "node scripts/check-docs.js",
    "check": "npm run check:syntax && npm run check:docs && npm test && npm run test:dsh-plugin"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "license": "MIT"
}
