{
  "name": "dsh-sgen",
  "version": "0.4.1",
  "private": true,
  "description": "SGeN 生图/生视频的 DeepSeek Harness 插件：原生工具、sgen 技能与试验场/配置/产物工作台。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sgen",
    "image-generation",
    "video-generation",
    "sensenova",
    "agnes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qjy0128/sgen.git",
    "directory": "dsh-plugin"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/client.js && node --test 'test/*.test.mjs'"
  }
}
